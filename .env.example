# Copy to .env and replace the placeholders with your local values.
SECRET_KEY=replace-with-a-secure-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],192.168.1.99
DB_NAME=belliazzi_trazabilidad
DB_USER=replace-with-your-database-user
DB_PASSWORD=replace-with-your-database-password
DB_HOST=127.0.0.1
DB_PORT=3306
# Activar después de aplicar, con autorización, las migraciones de django-axes.
# En producción DEBUG=False activa Axes por defecto.
# AXES_ENABLED=True
# Solo CIDR de los proxies reales (ALB / proxy interno). Vacío ignora X-Forwarded-For.
TRUSTED_PROXY_CIDRS=
