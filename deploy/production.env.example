# Plantilla para el gestor de entorno/secretos. NO copiar a .env local ni usar secretos de ejemplo.
# config.settings_production no lee el .env del repositorio.
DJANGO_SETTINGS_MODULE=config.settings_production
DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=belliazzi.example.com
CSRF_TRUSTED_ORIGINS=https://belliazzi.example.com
DB_ENGINE=postgresql
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/etc/belliazzi/rds-ca-bundle.pem
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10
STATIC_ROOT=/srv/belliazzi/staticfiles
# Activar después de verificar SG del ALB -> Nginx -> Gunicorn loopback.
TRUST_PROXY_HEADERS=False
# Añadir las redes reales de ALB/proxies; nunca 0.0.0.0/0 ni ::/0.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Inicialmente 0: W004 permanece hasta validar HTTPS y dominio.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
WEB_WORKERS=2
WEB_TIMEOUT=60
